# PostgreSQL JDBC URL (Render internal URL recommended when DB and backend are in same region)
DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=DATABASE_USER
DB_PASSWORD=CHANGE_ME

# Exact deployed frontend origin, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Leave demo password variables unset to use the credentials shown by the frontend.
# For an evaluation-only public demo, these defaults must match App.jsx.
# DEMO_ADMIN_PASSWORD=AdminDemo123!
# DEMO_STAKEHOLDER_PASSWORD=SupplierDemo123!
# DEMO_REVIEWER_PASSWORD=ReviewerDemo123!
DEMO_RESET_EXISTING_PASSWORDS=true
